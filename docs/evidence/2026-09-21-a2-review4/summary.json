    {
      "name": "storage-profile",
      "command": [
        "<WORKSPACE>/pr6-fix-envs/runtime311/bin/python",
        "-I",
        "-c",
        "\nimport json, os\nfrom pathlib import Path\nfrom infra_artifact_ledger import snapshot_storage as storage\nfd = os.open('.', os.O_RDONLY | os.O_DIRECTORY)\ntry:\n    mount_id = storage._fd_mount_id(fd)\n    mount = storage._mount_for(Path.cwd(), mount_id)\n    line = next(line for line in Path('/proc/self/mountinfo').read_text().split('\\n')\n                if line.partition(' ')[0] == str(mount_id))\n    print(json.dumps(dict(fs_type=mount.fs_type, mount_point=mount.point,\n                         fsync_volatile='fsync=volatile' in line,\n                         supported_local=mount.fs_type in storage.LOCAL_FILESYSTEMS)))\nfinally:\n    os.close(fd)\n"
      ],
