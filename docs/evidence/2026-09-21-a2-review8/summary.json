        "<WORKSPACE>/pr6-review8-envs/runtime311/bin/python",
        "-I",
        "-c",
        "\nimport hashlib, json, pathlib, subprocess, sys, tempfile\nfrom infra_artifact_ledger import initialize, recovery\nfrom infra_artifact_ledger import snapshot_storage as storage\nwith tempfile.TemporaryDirectory(prefix='a2-installed-rejection-') as temporary:\n    root = pathlib.Path(temporary)\n    output = root / 'output'\n    output.mkdir()\n    source = root / 'source.sqlite'\n    with initialize(source): pass\n    before = source.read_bytes()\n    try:\n        recovery.create(db=source, output_root=output, snapshot_id='a'*32, source_commit='b'*40)\n    except recovery.RecoveryError as error:\n        assert (error.code, error.publication_state) == ('UNSUPPORTED_STORAGE', 'not_published')\n    else:\n        raise AssertionError('sandbox unexpectedly accepted as supported filesystem')\n    cli = pathlib.Path(sys.executable).parent / 'artifact-ledger'\n    result = subprocess.run([sys.executable, '-I', str(cli), 'snapshot', 'create', '--db', str(source),\n        '--output-root', str(output), '--snapshot-id', 'a'*32, '--source-commit', 'b'*40],\n        capture_output=True, check=False)\n    value = json.loads(result.stdout)\n    assert result.returncode == 3 and result.stderr == b''\n    assert value['error']['code'] == 'UNSUPPORTED_STORAGE'\n    assert value['publication_state'] == 'not_published'\n    assert source.read_bytes() == before and list(output.iterdir()) == []\n    assert set(p.name for p in root.iterdir()) == {'source.sqlite','output'}\n    print(json.dumps(dict(result='PASS', scope='installed_unsupported_filesystem_rejection',\n          module_path=recovery.__file__, cli_exit_code=result.returncode,\n          positive_supported_filesystem_lifecycle='NOT_RUN', gx10='NOT_RUN', real_nas='NOT_RUN')))\n"
